// Worker del formulario de contacto. El correo de destino y las claves NO van
// aquí: el repositorio es público. Ver workers/contacto/README.md.
{
	"name": "amply-contacto",
	"main": "index.js",
	"compatibility_date": "2026-11-20",
	// Solo se usa a través del service binding de la Pages Function /api/contacto.
	"workers_dev": false,
	"preview_urls": false,
	"send_email": [
		{
			"name": "EMAIL"
			// En Cloudflare el binding está restringido al correo de destino verificado
			// (destination_address). Configúralo al desplegar; no lo escribas aquí.
		}
	]
	// Secretos (wrangler secret put): CONTACT_TO, TURNSTILE_SECRET
}
