  linkedin:
    '<rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 10.5V16"/><path d="M8 7.75v.01"/><path d="M12 16v-5.5"/><path d="M12 13.25a2.5 2.5 0 0 1 5 0V16"/>',
} as const;

export type Icon = keyof typeof icons;

interface Props {
  name: Icon;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = 'size-5', strokeWidth = 1.5 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={icons[name]}
/>
