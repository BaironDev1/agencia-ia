---
import ChatDemo from '../ChatDemo.astro';
import Icon from '../Icon.astro';
---

<section class="hero relative isolate overflow-hidden" aria-labelledby="hero-title">
  <!-- Decoración de fondo -->
  <div class="bg-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-[36rem] w-[64rem] max-w-none -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,var(--glow),transparent)] blur-2xl"
    aria-hidden="true"
  >
  </div>

  <div class="container-page grid grid-cols-1 items-center gap-14 pt-[8.5rem] pb-20 sm:pt-[10rem] lg:grid-cols-[1.15fr_0.85fr] lg:gap-12 lg:pt-[11rem] lg:pb-24">
    <div class="hero-text-exit">
      <p class="eyebrow enter">Agencia de software e IA</p>

      <h1 id="hero-title" class="text-display enter mt-6" style="--d: 1">
        Software e IA que <em
          class="font-serif text-[1.08em] font-normal tracking-[-0.02em] text-accent">trabajan</em
        > para tu negocio.
      </h1>

      <p class="enter mt-7 max-w-xl text-lg text-muted sm:text-xl" style="--d: 2">
        Empleados IA que venden y atienden por WhatsApp 24/7, y software a medida para tu operación.
      </p>

      <div class="enter mt-9 flex flex-wrap gap-3" style="--d: 3">
        <a href="#contacto" class="btn btn-primary">
          Agenda un diagnóstico gratis
          <Icon name="arrow" strokeWidth={2} />
        </a>
        <a href="#planes" class="btn btn-ghost">Ver planes</a>
      </div>

      <p class="enter mt-4 max-w-md text-sm text-subtle" style="--d: 4">
        30 minutos, sin costo. Si no vemos dónde la IA te ahorra plata, te lo decimos.
      </p>

      <ul class="enter mt-8 flex flex-wrap gap-2" style="--d: 5">
        {
          ['Listo en 2–4 semanas', 'Garantía 60 días', 'Sin permanencia'].map((chip) => (
            <li class="rounded-full border border-line-strong px-3.5 py-1.5 text-sm text-fg">{chip}</li>
          ))
        }
      </ul>
    </div>

    <!-- Chat demo del empleado IA -->
    <div class="hero-visual-exit mx-auto w-full max-w-md lg:max-w-none">
      <div class="enter" style="--d: 3">
        <ChatDemo />
      </div>
    </div>
  </div>
</section>
