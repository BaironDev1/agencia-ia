---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  intro?: string;
  align?: 'center' | 'left';
  class?: string;
}

const { id, eyebrow, title, intro, align = 'center', class: className = '' } = Astro.props;
const centered = align === 'center';
---

<header class:list={['reveal', centered ? 'mx-auto max-w-3xl text-center' : 'max-w-3xl', className]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id} class="text-title mt-5">
    <slot name="title">{title}</slot>
  </h2>
  {intro && <p class:list={['mt-5 max-w-2xl text-lg text-muted', centered && 'mx-auto']}>{intro}</p>}
</header>
